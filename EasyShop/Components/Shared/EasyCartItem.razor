<RadzenCard Variant="Variant.Outlined" class="animate-card" Style="@_cardStyle" @onclick="@ToggleSelection">

    <div class="cart-delete-zone" @onclick:stopPropagation>
        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                      Size="ButtonSize.Medium" Variant="Variant.Text"
                      Click="@HandleDelete" />
    </div>

    @if (!string.IsNullOrEmpty(Data.ImageDataUri))
    {
        <img src="@Data.ImageDataUri" class="product-card-image" @onclick:stopPropagation @onclick="ShowPreview" />
    }
    else
    {
        <div class="product-image-zone">
            <RadzenIcon Icon="shopping_bag" Style="width: 40px; height: 40px;" />
        </div>
    }

    <div style="display: flex; align-items: center; gap: 0.75rem; min-height: 64px; padding-right: 48px; padding-left: 64px;">
        <div style="flex: 1; min-width: 0;">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0"><strong>@(Data.Name)</strong></RadzenText>
            @if (!string.IsNullOrEmpty(Data.Description))
            {
                <span style="font-size: 0.85rem; color: var(--rz-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;">@Data.Description</span>
            }
            <div style="display: flex; justify-content: space-between;">
                <span>Unidades</span>
                <span>@Data.Units</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span>Costo total</span>
                <span>@($"{Data.TotalCost.Amount:F2} {Data.TotalCost.Currency}")</span>
            </div>
        </div>
    </div>
</RadzenCard>

@if (_showPreview)
{
    <div class="cart-item-overlay" @onclick="ClosePreview">
        <span class="cart-item-overlay-close">&times;</span>
        <img src="@Data.ImageDataUri" class="cart-item-overlay-content" @onclick:stopPropagation />
    </div>
}

@code {
    [EditorRequired, Parameter] public Product Data { get; set; }

    [Parameter] public bool IsSelected { get; set; }

    [Parameter] public EventCallback<bool> IsSelectedChanged { get; set; }

    [Parameter] public EventCallback<Guid> Delete { get; set; }

    private bool _isSelected;
    private bool _showPreview;
    private string _cardStyle = "";

    protected override void OnInitialized()
    {
        _isSelected = IsSelected;
        UpdateCardStyle();
    }

    private void ToggleSelection()
    {
        _isSelected = !_isSelected;
        UpdateCardStyle();
        IsSelectedChanged.InvokeAsync(_isSelected);
    }

    void UpdateCardStyle()
    {
        _cardStyle = "position: relative; cursor: pointer; overflow: hidden;"
            + (_isSelected ? "background: color-mix(in srgb, var(--rz-primary) 12%, var(--rz-base));" : "");
    }

    private async Task HandleDelete()
    {
        if (Delete.HasDelegate)
            await Delete.InvokeAsync(Data.Id);
    }

    private void ShowPreview()
    {
        if (!string.IsNullOrEmpty(Data.ImageDataUri))
            _showPreview = true;
    }

    private void ClosePreview()
    {
        _showPreview = false;
    }
}

<style>
    .cart-delete-zone {
        position: absolute;
        top: 0;
        right: 0;
        height: 100%;
        width: 48px;
    }
    .cart-delete-zone .rz-button {
        height: 100% !important;
        width: 100% !important;
        border-radius: 0 !important;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .product-card-image {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 64px;
        object-fit: cover;
        transition: transform 0.2s ease;
        flex-shrink: 0;
    }
    .product-image-zone {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .animate-card:hover .product-card-image {
        transform: scale(1.15);
    }

    .cart-item-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.8);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        animation: fadeIn 0.2s ease;
    }

    .cart-item-overlay-content {
        max-width: 90vw;
        max-height: 90vh;
        object-fit: contain;
        border-radius: 8px;
        cursor: default;
        animation: scaleIn 0.25s ease;
    }

    .cart-item-overlay-close {
        position: absolute;
        top: 16px;
        right: 24px;
        font-size: 36px;
        color: #fff;
        cursor: pointer;
        line-height: 1;
        opacity: 0.8;
        transition: opacity 0.2s;
    }

    .cart-item-overlay-close:hover {
        opacity: 1;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes scaleIn {
        from { transform: scale(0.9); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
</style>
