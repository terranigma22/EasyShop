<RadzenCard Variant="Variant.Flat"
    Style="@_cardStyle">

    <div class="cart-item-check-zone" @onclick:stopPropagation>
        <RadzenCheckBox @bind-Value="@_isSelected" TValue="bool" Change="@HandleSelectionChanged" />
    </div>

    <div style="display: flex; align-items: center; gap: 0.75rem; padding-right: 96px; padding-left: 40px; min-height: 64px;">
        @if (!string.IsNullOrEmpty(Data.ImageDataUri))
        {
            <img src="@Data.ImageDataUri" class="cart-item-image-square" @onclick:stopPropagation @onclick="ShowPreview" />
        }
        else
        {
            <div class="cart-item-image-square-fallback">
                <RadzenIcon Icon="shopping_bag" Style="width: 24px; height: 24px;" />
            </div>
        }
        <div style="flex: 1; min-width: 0;">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0"><strong>@(Data.Name)</strong></RadzenText>
            @if (!string.IsNullOrEmpty(Data.Description))
            {
                <span style="font-size: 0.85rem; color: var(--rz-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;">@Data.Description</span>
            }
            <div style="display: flex; justify-content: space-between;">
                <span>Unidades</span>
                <span>@Data.Units</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span>Costo total</span>
                <span>@($"{Data.TotalCost.Amount:F2} {Data.TotalCost.Currency}")</span>
            </div>
        </div>
    </div>

    <div class="cart-item-action-zone" @onclick:stopPropagation>
        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                      Size="ButtonSize.Medium" Variant="Variant.Text"
                      Click="@HandleDelete" />
        <RadzenButton Icon="shopping_cart_checkout" ButtonStyle="ButtonStyle.Success"
                      Size="ButtonSize.Medium" Variant="Variant.Text"
                      Click="@HandlePurchase" />
    </div>
</RadzenCard>

@if (_showPreview)
{
    <div class="cart-item-overlay" @onclick="ClosePreview">
        <span class="cart-item-overlay-close">&times;</span>
        <img src="@Data.ImageDataUri" class="cart-item-overlay-content" @onclick:stopPropagation />
    </div>
}

@code {
    [EditorRequired, Parameter] public Product Data { get; set; }

    [Parameter] public EventCallback<Guid> Purchase { get; set; }

    [Parameter] public EventCallback<Guid> Delete { get; set; }

    [Parameter] public bool IsSelected { get; set; }

    [Parameter] public EventCallback<bool> IsSelectedChanged { get; set; }

    private bool _isSelected;
    private bool _showPreview;
    private string _cardStyle = "";

    protected override void OnInitialized()
    {
        _isSelected = IsSelected;
        UpdateCardStyle();
    }

    private async Task HandleSelectionChanged(bool value)
    {
        _isSelected = value;
        UpdateCardStyle();
        await IsSelectedChanged.InvokeAsync(value);
    }

    void UpdateCardStyle()
    {
        _cardStyle = "position: relative; overflow: hidden;"
            + (_isSelected ? "outline: 2px solid var(--rz-primary);" : "");
    }

    private async Task HandlePurchase()
    {
        if (Purchase.HasDelegate)
            await Purchase.InvokeAsync(Data.Id);
    }

    private async Task HandleDelete()
    {
        if (Delete.HasDelegate)
            await Delete.InvokeAsync(Data.Id);
    }

    private void ShowPreview()
    {
        if (!string.IsNullOrEmpty(Data.ImageDataUri))
            _showPreview = true;
    }

    private void ClosePreview()
    {
        _showPreview = false;
    }
}

<style>
    .cart-item-check-zone {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
    }

    .cart-item-action-zone {
        position: absolute;
        top: 0;
        right: 0;
        height: 100%;
        width: 96px;
        display: flex;
        align-items: center;
    }
    .cart-item-action-zone .rz-button {
        height: 100% !important;
        width: 48px !important;
        border-radius: 0 !important;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .cart-item-image-square {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 8px;
        flex-shrink: 0;
        cursor: pointer;
    }
    .cart-item-image-square-fallback {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--rz-base-200);
    }

    .cart-item-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.8);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        animation: fadeIn 0.2s ease;
    }

    .cart-item-overlay-content {
        max-width: 90vw;
        max-height: 90vh;
        object-fit: contain;
        border-radius: 8px;
        cursor: default;
        animation: scaleIn 0.25s ease;
    }

    .cart-item-overlay-close {
        position: absolute;
        top: 16px;
        right: 24px;
        font-size: 36px;
        color: #fff;
        cursor: pointer;
        line-height: 1;
        opacity: 0.8;
        transition: opacity 0.2s;
    }

    .cart-item-overlay-close:hover {
        opacity: 1;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes scaleIn {
        from { transform: scale(0.9); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
</style>
