<RadzenCard Variant="Variant.Outlined" Style="@_cardStyle" @onclick="@ToggleSelection">

    <div style="display: flex; align-items: center; gap: 0.75rem; min-height: 64px;">
        @if (!string.IsNullOrEmpty(Data.ImageDataUri))
        {
            <img src="@Data.ImageDataUri" class="cart-item-image-square" @onclick:stopPropagation @onclick="ShowPreview" />
        }
        else
        {
            <div class="cart-item-image-square-fallback">
                <RadzenIcon Icon="shopping_bag" Style="width: 24px; height: 24px;" />
            </div>
        }
        <div style="flex: 1; min-width: 0;">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-0"><strong>@(Data.Name)</strong></RadzenText>
            @if (!string.IsNullOrEmpty(Data.Description))
            {
                <span style="font-size: 0.85rem; color: var(--rz-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;">@Data.Description</span>
            }
            <div style="display: flex; justify-content: space-between;">
                <span>Unidades</span>
                <span>@Data.Units</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span>Costo total</span>
                <span>@($"{Data.TotalCost.Amount:F2} {Data.TotalCost.Currency}")</span>
            </div>
        </div>
    </div>
</RadzenCard>

@if (_showPreview)
{
    <div class="cart-item-overlay" @onclick="ClosePreview">
        <span class="cart-item-overlay-close">&times;</span>
        <img src="@Data.ImageDataUri" class="cart-item-overlay-content" @onclick:stopPropagation />
    </div>
}

@code {
    [EditorRequired, Parameter] public Product Data { get; set; }

    [Parameter] public bool IsSelected { get; set; }

    [Parameter] public EventCallback<bool> IsSelectedChanged { get; set; }

    private bool _isSelected;
    private bool _showPreview;
    private string _cardStyle = "";

    protected override void OnInitialized()
    {
        _isSelected = IsSelected;
        UpdateCardStyle();
    }

    private void ToggleSelection()
    {
        _isSelected = !_isSelected;
        UpdateCardStyle();
        IsSelectedChanged.InvokeAsync(_isSelected);
    }

    void UpdateCardStyle()
    {
        _cardStyle = "cursor: pointer;"
            + (_isSelected ? "background: color-mix(in srgb, var(--rz-primary) 12%, var(--rz-base));" : "");
    }

    private void ShowPreview()
    {
        if (!string.IsNullOrEmpty(Data.ImageDataUri))
            _showPreview = true;
    }

    private void ClosePreview()
    {
        _showPreview = false;
    }
}

<style>
    .cart-item-image-square {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 8px;
        flex-shrink: 0;
        cursor: pointer;
    }
    .cart-item-image-square-fallback {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--rz-base-200);
    }

    .cart-item-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.8);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        animation: fadeIn 0.2s ease;
    }

    .cart-item-overlay-content {
        max-width: 90vw;
        max-height: 90vh;
        object-fit: contain;
        border-radius: 8px;
        cursor: default;
        animation: scaleIn 0.25s ease;
    }

    .cart-item-overlay-close {
        position: absolute;
        top: 16px;
        right: 24px;
        font-size: 36px;
        color: #fff;
        cursor: pointer;
        line-height: 1;
        opacity: 0.8;
        transition: opacity 0.2s;
    }

    .cart-item-overlay-close:hover {
        opacity: 1;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes scaleIn {
        from { transform: scale(0.9); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
</style>
