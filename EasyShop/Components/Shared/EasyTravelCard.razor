<RadzenCard Variant="Variant.Flat" class="animate-card">
    <AnimateFadeIn>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">

            <RadzenButton Icon="check" ButtonStyle="@_buttonStyle" Click="@(() => OnSelected.InvokeAsync(Data.Id))"
                          Size="ButtonSize.Medium" />

            <RadzenStack Gap="0">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.5rem">
                    <RadzenIcon Icon="calendar_month" Style="font-size: 1.25rem;" />
                    <span style="font-weight: 500;">
                        @Data.StartDate.ToString("dd/MM/yyyy") → @Data.EndDate.ToString("dd/MM/yyyy")
                    </span>
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="payments" Style="font-size: 1.25rem;" />
                    <span>@($"{Data.MoneyToTravel.ToString()} {Data.MoneyToTravel.Currency}")</span>
                    
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="swap_horiz" Style="font-size: 1.25rem; " />
                    <span>@($"{Data.ChangeValue.Amount.ToString()} {Data.ChangeValue.Currency}")</span>
                    <RadzenIcon Icon="calculate" Style="font-size: 1.25rem; margin-left: 0.5rem;" />
                    <span>@Data.Multiplicator.ToString("F2")</span>
                </RadzenStack>

            </RadzenStack>
        </RadzenStack>
    </AnimateFadeIn>
</RadzenCard>

@code {
    [EditorRequired, Parameter] public Travel Data { get; set; }
    [Parameter] public bool IsCurrent { get; set; }
    [Parameter] public EventCallback<Guid> OnSelected { get; set; }
    [Parameter] public EventCallback OnAdded { get; set; }
    [Parameter] public EventCallback OnEdited { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }
    [Parameter] public EventCallback OnRestored { get; set; }

    ButtonStyle _buttonStyle => IsCurrent
        ? ButtonStyle.Primary
        : ButtonStyle.Base;

    void OnAdd()
    {
        OnAdded.InvokeAsync();
    }
}
