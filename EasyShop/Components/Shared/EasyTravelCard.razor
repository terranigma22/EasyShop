<RadzenCard Variant="Variant.Flat" class="animate-card" Style="cursor: pointer; position: relative; overflow: hidden;" @onclick="@HandleClick">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="padding-right: 48px;">
        <div class="stat-card-icon">
            <RadzenIcon Icon="check" IconColor="@_iconColor" />
        </div>
        <RadzenStack Gap="0" Style="flex: 1;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenIcon Icon="calendar_month" Style="font-size: 1.25rem;" />
                <span style="font-weight: 500;">
                    @Data.StartDate.ToString("dd/MM/yyyy") → @Data.EndDate.ToString("dd/MM/yyyy")
                </span>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="payments" Style="font-size: 1.25rem;" />
                <span style="flex: 1;">Presupuesto</span>
                <span>@($"{Data.MoneyToTravel.ToUI()}")</span>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="swap_horiz" Style="font-size: 1.25rem;" />
                <span style="flex: 1;">Venta</span>
                <span>@($"{Data.ChangeValue.ToUI()}")</span>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="swap_horiz" Style="font-size: 1.25rem;" />
                <span style="flex: 1;">Compra</span>
                <span>@($"{Data.ChangeValueToBuy.ToUI()}")</span>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="calculate" Style="font-size: 1.25rem;" />
                <span style="flex: 1;">Multiplicador</span>
                <span>@Data.Multiplicator.ToString("F2")</span>
            </RadzenStack>
        </RadzenStack>
    </RadzenStack>
    <div class="travel-delete-zone" @onclick:stopPropagation>
        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                      Size="ButtonSize.Medium" Variant="Variant.Text"
                      Click="@HandleDelete" />
    </div>
</RadzenCard>

@code {
    [EditorRequired, Parameter] public Travel Data { get; set; }
    
    [Parameter] public bool IsCurrent { get; set; }

    [Parameter] public EventCallback<Guid> Click { get; set; }

    [Parameter] public EventCallback<Guid> Delete { get; set; }

    private async Task HandleClick()
    {
        if (Click.HasDelegate)
            await Click.InvokeAsync(Data.Id);
    }

    private async Task HandleDelete()
    {
        if (Delete.HasDelegate)
            await Delete.InvokeAsync(Data.Id);
    }

    string _iconColor => IsCurrent
        ? Colors.Primary
        : Colors.Base400;
}

<style>
    .stat-card-icon {
        font-size: var(--easysell-text-3xl);
    }
    .travel-delete-zone {
        position: absolute;
        top: 0;
        right: 0;
        height: 100%;
        width: 48px;
    }
    .travel-delete-zone .rz-button {
        height: 100% !important;
        width: 100% !important;
        border-radius: 0 !important;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>
