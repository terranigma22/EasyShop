<RadzenCard Variant="Variant.Flat" class="animate-card" Style="cursor: pointer;" @onclick="@HandleClick">
    <AnimateFadeIn>

        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div class="stat-card-icon">
                    <RadzenIcon Icon="@Icon" IconColor="@IconColor" />
                </div>
                <span style="font-weight: 600; font-size: 1.5rem;">@Value</span>
                <span style="color: var(--rz-text-secondary);">@Title</span>
            </div>
            <span style="font-size: 0.875rem;">
                @Subtitle
            </span>
        </div>

    </AnimateFadeIn>
</RadzenCard>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public int Value { get; set; } = 0;
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "analytics";
    [Parameter] public string IconColor { get; set; } = Colors.Base400;

    [Parameter] public EventCallback Click { get; set; }

    private async Task HandleClick()
    {
        if (Click.HasDelegate)
            await Click.InvokeAsync();
    }   
}

<style>
    .stat-card-icon {
        font-size: var(--easysell-text-3xl);
    }
</style>