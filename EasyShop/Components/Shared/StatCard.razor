<RadzenCard Variant="Variant.Flat" class="animate-card">
    <AnimateFadeIn>
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div class="stat-card-title">@Title</div>
                <div class="stat-card-value">@Value</div>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <div style="font-size: var(--easysell-text-sm); color: var(--easysell-gray-500); margin-top: var(--easysell-space-1);">
                        @Subtitle
                    </div>
                }
            </div>
            <div class="stat-card-icon">
                <RadzenIcon Icon="@Icon" IconColor="@IconColor" />
            </div>
        </div>
        @if (ChildContent != null)
        {
            <div style="margin-top: var(--easysell-space-4);">
                @ChildContent
            </div>
        }
    </AnimateFadeIn>
</RadzenCard>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "analytics";
    [Parameter] public string IconColor { get; set; } = Colors.Base400;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

<style>
    .stat-card-title {
        font-size: var(--easysell-text-sm);
        margin-bottom: var(--easysell-space-2);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .stat-card-value {
        font-size: var(--easysell-text-3xl);
        font-weight: 700;
        line-height: 1;
    }

    .stat-card-icon {
        float: right;
        font-size: var(--easysell-text-3xl);
    }

</style>