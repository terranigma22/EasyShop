@page "/expenses"

@using EasyShop.Domain.Models
@using EasyShop.Services
@using EasyShop.Features.Expenses

@inject TravelStateService TravelState
@inject DeleteExpenseHandler DeleteExpenseHandler
@inject NotificationService NotificationService

<PageContainer>
    <RadzenRow>
        <RadzenColumn>
            <PageHeader Title="@($"Gastos: {_travel?.Expenses.Count}")" Icon="money_off" />
        </RadzenColumn>
        <RadzenColumn Style="align-self: center;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                              Click="@Create" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    @if (_travel == null)
    {
        <EmptyState Icon="travel" Title="No hay viaje activo" Message="Selecciona un viaje para ver sus gastos">
            <RadzenButton Icon="travel" ButtonStyle="ButtonStyle.Primary" Text="Ir a Viajes"
                          Click="@(() => NavigationManager.NavigateTo("/travels"))" />
        </EmptyState>
    }
    else if (_travel.Expenses.Count == 0)
    {
        <EmptyState Icon="money_off" Title="Sin gastos" Message="Este viaje no tiene gastos registrados">
            <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Text="Crear primer gasto"
                              Click="@Create" />
        </EmptyState>
    }
    else
    {
        <ListContainer>
            <AnimateFadeIn>
                <EasyGridForCards>
                    @foreach (var item in _travel.Expenses)
                    {
                        <EasyColumForCard>
                            <EasyExpenseCard Data="item" Delete="@HandleDelete" />
                        </EasyColumForCard>
                    }
                </EasyGridForCards>
            </AnimateFadeIn>
        </ListContainer>
    }
</PageContainer>

@code {
    Travel? _travel;

    protected override void OnInitialized()
    {
        _travel = TravelState.CurrentTravel;
    }

    private async Task HandleDelete(Guid id)
    {
        var confirmed = await DialogService.Confirm(
            "¿Estás seguro de eliminar este gasto?",
            "Eliminar Gasto",
            new ConfirmOptions { OkButtonText = "Sí", CancelButtonText = "No" });

        if (confirmed == true)
        {
            await DeleteExpenseHandler.HandleAsync(new DeleteExpenseRequest(id));
            await TravelState.SetCurrentTravelAsync(_travel!.Id);
            _travel = TravelState.CurrentTravel;
            NotificationService.Notify(NotificationSeverity.Success, "Gasto eliminado correctamente");
        }
    }

    async Task Create()
    {
        var result = await DialogService.OpenSideAsync<ExpenseCreate>("Nuevo Gasto",
            null,
            new SideDialogOptions
            {
                Width = "600px",
                ShowClose = false,
                ShowMask = true,
                CloseDialogOnOverlayClick = true,
                Position = DialogPosition.Right
            });

        if (result)
        {
            _travel = TravelState.CurrentTravel;
        }
    }
}
