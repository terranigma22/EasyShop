@page "/expenses"

@using EasyShop.Domain.Models
@using EasyShop.Services

@inject TravelStateService TravelState
@inject NotificationService NotificationService

<PageContainer>
    <RadzenRow>
        <RadzenColumn>
            <PageHeader Title="@($"Gastos: {_travel?.Expenses.Count}")" Icon="money_off" />
        </RadzenColumn>
        <RadzenColumn Style="align-self: center;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                              Click="@(() => NavigationManager.NavigateTo("/expenses/create"))" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    @if (_travel == null)
    {
        <EmptyState Icon="travel" Title="No hay viaje activo" Message="Selecciona un viaje para ver sus gastos">
            <RadzenButton Icon="travel" ButtonStyle="ButtonStyle.Primary" Text="Ir a Viajes"
                          Click="@(() => NavigationManager.NavigateTo("/travels"))" />
        </EmptyState>
    }
    else if (_travel.Expenses.Count == 0)
    {
        <EmptyState Icon="money_off" Title="Sin gastos" Message="Este viaje no tiene gastos registrados" />
    }
    else
    {
        <ListContainer>
            <AnimateFadeIn>
                <EasyGridForCards>
                    @foreach (var item in _travel.Expenses)
                    {
                        <EasyColumForCard>
                            <RadzenCard Variant="Variant.Flat" class="animate-card">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                             JustifyContent="JustifyContent.SpaceBetween">
                                    <span style="font-weight: 500;">@item.Description</span>
                                    <span style="font-weight: 600; color: var(--rz-danger);">
                                        − @($"{item.Value.Amount:F2} {item.Value.Currency}")
                                    </span>
                                </RadzenStack>
                            </RadzenCard>
                        </EasyColumForCard>
                    }
                </EasyGridForCards>
            </AnimateFadeIn>
        </ListContainer>
    }
</PageContainer>

@code {
    Travel? _travel;

    protected override void OnInitialized()
    {
        _travel = TravelState.CurrentTravel;
    }
}
