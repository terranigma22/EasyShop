@page "/"
@using EasyShop.Domain.Primitives
@using EasyShop.Services

@inject TravelStateService TravelState

<PageContainer>

    @if (_travel == null)
    {
        <EmptyState Icon="travel" Title="No hay viaje activo" Message="Selecciona o crea un viaje para comenzar">
            <RadzenButton Icon="travel" ButtonStyle="ButtonStyle.Primary" Text="Ir a Viajes"
                          Click="@(() => NavigationManager.NavigateTo("/travels"))" />
        </EmptyState>
    }
    else
    {
        <RadzenRow Gap="1rem">

            <RadzenColumn Size="12">
                <RadzenCard Variant="Variant.Flat" class="animate-card">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">

                        <div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
                            <span>Presupuesto</span>
                            <span style="font-weight: 500;">@($"{_travel.MoneyToTravel.Amount:F2} {_travel.MoneyToTravel.Currency}")</span>
                        </div>

                        <div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
                            <span>Productos</span>
                            <span style="color: var(--rz-danger);">− @($"{_travel.GetProductsTotal():F2} {_travel.MoneyToTravel.Currency}")</span>
                        </div>

                        <div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
                            <span>Gastos</span>
                            <span style="color: var(--rz-danger);">− @($"{_travel.GetExpensesTotal():F2} {_travel.MoneyToTravel.Currency}")</span>
                        </div>

                        <div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
                            <span>Entradas</span>
                            <span style="color: var(--rz-success);">+ @($"{_travel.GetIncomesTotal():F2} {_travel.MoneyToTravel.Currency}")</span>
                        </div>

                        <div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
                            <span>Ganancias</span>
                            <span style="color: var(--rz-success);">
                                @($"{_travel.GetProfit(_travel.MoneyToTravel.Currency):F2} {_travel.MoneyToTravel.Currency}")
                            </span>
                        </div>
                        @if (_travel.ChangeValue.Currency != _travel.MoneyToTravel.Currency)
                        {
                            <div style="display: flex; justify-content: space-between; padding: 0.1rem 0 0.25rem 0;">
                                <span></span>
                                <span style="color: var(--rz-success); font-size: 0.85rem;">
                                    @($"{_travel.GetProfit(_travel.ChangeValue.Currency):F2} {_travel.ChangeValue.Currency}")
                                </span>
                            </div>
                        }

                        <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-top: 1px solid var(--rz-border-color);">
                            <span style="font-weight: 600;">Restante</span>
                            <span style="font-weight: 600; color: @(_remaining >= 0 ? "var(--rz-success)" : "var(--rz-danger)");">
                                @($"{_remaining:F2} {_travel.MoneyToTravel.Currency}")
                            </span>
                        </div>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12">
                <RadzenCard Variant="Variant.Flat" class="animate-card">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="text-align: center;">
                        <RadzenButton Icon="inventory_2" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Large" Variant="Variant.Text" class="rz-border-radius-10"/>
                        <span style="font-weight: 600; font-size: 1.5rem;">@_travel.Products.Count</span>
                        <span style="color: var(--rz-text-secondary);">Productos</span>
                        <span style="font-size: 0.875rem;">
                            @($"{_travel.Products.Sum(p => p.TotalCost.Amount):F2} {_travel.MoneyToTravel.Currency}")
                        </span>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12">
                <RadzenCard Variant="Variant.Flat" class="animate-card">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="text-align: center;">
                        <RadzenButton Icon="money_off" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Large" Variant="Variant.Text" class="rz-border-radius-10" />
                        <span style="font-weight: 600; font-size: 1.5rem;">@_travel.Expenses.Count</span>
                        <span style="color: var(--rz-text-secondary);">Gastos</span>
                        <span style="font-size: 0.875rem;">
                            @($"{_travel.Expenses.Sum(e => e.Value.Amount):F2} {_travel.MoneyToTravel.Currency}")
                        </span>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12">
                <RadzenCard Variant="Variant.Flat" class="animate-card">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="text-align: center;">
                        <RadzenButton Icon="account_balance" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Large" Variant="Variant.Text" class="rz-border-radius-10" />
                        <span style="font-weight: 600; font-size: 1.5rem;">@_travel.Incomes.Count</span>
                        <span style="color: var(--rz-text-secondary);">Entradas</span>
                        <span style="font-size: 0.875rem;">
                            @($"{_travel.Incomes.Sum(i => i.Value.Amount):F2} {_travel.ChangeValue.Currency}")
                        </span>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    }
</PageContainer>

@code {
    Travel? _travel { get; set; }

    decimal? _remaining => _travel?.GetRemaining();

    protected override void OnInitialized()
    {
        _travel = TravelState.CurrentTravel;
    }
}