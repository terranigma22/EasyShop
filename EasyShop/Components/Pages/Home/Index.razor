@page "/"

@using EasyShop.Domain.Primitives
@using EasyShop.Services

@inject TravelStateService TravelState

<PageContainer>

    @if (_travel == null)
    {

        <EmptyState Icon="travel" Title="No hay viajes" Message="Selecciona o crea un viaje para comenzar">

            <RadzenButton Icon="travel" ButtonStyle="ButtonStyle.Primary" Text="Ir a Viajes"
                          Click="@(() => NavigationManager.NavigateTo("/travels"))" />
        </EmptyState>
    }
    else
    {
        <RadzenRow Gap="1rem">

            <RadzenColumn Size="12">
                <RadzenCard Variant="Variant.Filled">
                    <AnimateFadeIn>
                        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">

                            <div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
                                <span>Presupuesto</span>
                                <span style="font-weight: 500;">@($"{_travel.MoneyToTravel.Amount:F2}           {_travel.MoneyToTravel.Currency}")</span>
                            </div>

                            <div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
                                <span>Productos</span>
                                <span style="color: var(--rz-danger);">− @($"{_travel.GetProductsTotal():F2}          {_travel.MoneyToTravel.Currency}")</span>
                            </div>

                            <div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
                                <span>Gastos</span>
                                <span style="color: var(--rz-danger);">− @($"{_travel.GetExpensesTotal():F2}                          {_travel.MoneyToTravel.Currency}")</span>
                            </div>

                            <div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
                                <span>Entradas</span>
                                <span style="color: var(--rz-success);">+ @($"{_travel.GetIncomesTotal():F2}                        {_travel.MoneyToTravel.Currency}")</span>
                            </div>

                            <div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
                                <span>Ventas Esperadas</span>
                                <span style="color: var(--rz-success);">
                                    @($"{_travel.GetTotalPrices():F2}                        {_travel.MoneyToTravel.Currency}")
                                </span>
                            </div>
                            @if (_travel.ChangeValue.Currency != _travel.MoneyToTravel.Currency)
                            {
                                <div style="display: flex; justify-content: space-between; padding: 0.1rem 0 0.25rem 0;">
                                    <span>Ventas Esperadas</span>
                                    <span style="color: var(--rz-success); font-size: 1rem;">
                                        @($"{_travel.GetTotalChangePrices():F2} {_travel.ChangeValue.Currency}")
                                    </span>
                                </div>
                            }

                            <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-top: 1px solid var(--rz-border-color);">
                                <span style="font-weight: 600;">Restante</span>
                                <span style="font-weight: 600; color: @(_remaining >= 0 ? "var(--rz-info)" : "var(--rz-danger)");">
                                    @($"{_remaining:F2} {_travel.MoneyToTravel.Currency}")
                                </span>
                            </div>
                        </RadzenStack>
                    </AnimateFadeIn>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12">
                <StatCard Title="Productos"
                          Icon="inventory_2" IconColor="@Colors.Info"
                           Value="@_travel.Products.Count(p => p.Status == ProductStatus.Purchased)"
                           Subtitle="@($"{_travel.Products.Where(p => p.Status == ProductStatus.Purchased).Sum(p => p.TotalCost.Amount):F2} {_travel.MoneyToTravel.Currency}")"
                          Click="@(() => NavigationManager.NavigateTo("/products"))" />
            </RadzenColumn>

            <RadzenColumn Size="12">
                <StatCard Title="Deseados"
                          Icon="inventory_2" IconColor="@Colors.WarningLight"
                          Value="@_travel.Products.Count(p => p.Status == ProductStatus.Wishlisted)"
                          Subtitle="@($"{_travel.Products.Where(p => p.Status == ProductStatus.Wishlisted).Sum(p => p.TotalCost.Amount):F2} {_travel.MoneyToTravel.Currency}")"
                          Click="@(() => NavigationManager.NavigateTo("/wishlist"))" />
            </RadzenColumn>


            <RadzenColumn Size="12">
                <StatCard Title="Gastos"
                          Icon="money_off" IconColor="@Colors.Danger"
                          Value="@_travel.Expenses.Count"
                          Subtitle="@($"{_travel.Expenses.Sum(e => e.Value.Amount):F2} {_travel.MoneyToTravel.Currency}")"
                          Click="@(() => NavigationManager.NavigateTo("/expenses"))" />
            </RadzenColumn>

            <RadzenColumn Size="12">
                <StatCard Title="Entradas"
                          Icon="account_balance" IconColor="@Colors.SuccessLight"
                          Value="@_travel.Incomes.Count"
                          Subtitle="@($"{_travel.Incomes.Sum(i => i.Value.Amount):F2} {_travel.MoneyToTravel.Currency}")"
                          Click="@(() => NavigationManager.NavigateTo("/incomes"))" />
            </RadzenColumn>

        </RadzenRow>
    }
</PageContainer>

    @code {
    Travel? _travel { get; set; }

    decimal? _remaining => _travel?.GetRemaining();

    protected override void OnInitialized()
    {
        _travel = TravelState.CurrentTravel;

        if (_travel == null)
            NavigationManager.NavigateTo("/travels");
    }
}