@page "/products"

@using EasyShop.Domain.Models
@using EasyShop.Services
@using EasyShop.Features.Products

@inject TravelStateService TravelState
@inject DeleteProductHandler DeleteProductHandler
@inject NotificationService NotificationService

<PageContainer>
    <RadzenRow>
        <RadzenColumn>
            <PageHeader Title="@($"Productos comprados: {_travel?.Products.Count(p => p.Status == ProductStatus.Purchased)}")" Icon="inventory_2" />
        </RadzenColumn>
        <RadzenColumn Style="align-self: center;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                              Click="@Create" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    @if (_travel == null)
    {
        <EmptyState Icon="travel" Title="No hay viaje activo" Message="Selecciona un viaje para ver sus productos">
            <RadzenButton Icon="travel" ButtonStyle="ButtonStyle.Primary" Text="Ir a Viajes"
                          Click="@(() => NavigationManager.NavigateTo("/travels"))" />
        </EmptyState>
    }
    else if (_travel.Products.Count(p => p.Status == ProductStatus.Purchased) == 0)
    {
        <EmptyState Icon="inventory_2" Title="Sin productos" Message="Este viaje no tiene productos registrados">
            <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Text="Crear primer producto"
                          Click="@Create" />
        </EmptyState>
    }
    else
    {
        <ListContainer>
            <AnimateFadeIn>
                <EasyGridForCards>
                    @foreach (var item in _travel.Products.Where(p => p.Status == ProductStatus.Purchased))
                    {
                        <EasyColumForCard>
                            <EasyProductCard Data="item" Click="@HandleCardSelected" Delete="@HandleDelete" />
                        </EasyColumForCard>
                    }
                </EasyGridForCards>
            </AnimateFadeIn>
        </ListContainer>
    }
</PageContainer>

@code {
    Travel? _travel;

    protected override void OnInitialized()
    {
        _travel = TravelState.CurrentTravel;
    }

    private async Task HandleCardSelected(Guid id)
    {
        var result = await DialogService.OpenSideAsync<ProductEdit>("Editar Producto",
            new Dictionary<string, object?> { { "ProductId", id } },
            new SideDialogOptions
            {
                Width = "600px",
                ShowClose = false,
                ShowMask = true,
                CloseDialogOnOverlayClick = true,
                Position = DialogPosition.Right
            });

        if (result)
        {
            _travel = TravelState.CurrentTravel;
        }
    }

    private async Task HandleDelete(Guid id)
    {
        var confirmed = await DialogService.Confirm(
            "¿Estás seguro de eliminar este producto?",
            "Eliminar Producto",
            new ConfirmOptions { OkButtonText = "Sí", CancelButtonText = "No" });

        if (confirmed == true)
        {
            await DeleteProductHandler.HandleAsync(new DeleteProductRequest(id));
            await TravelState.SetCurrentTravelAsync(_travel!.Id);
            _travel = TravelState.CurrentTravel;
            NotificationService.Notify(NotificationSeverity.Success, "Producto eliminado correctamente");
        }
    }

    async Task Create()
    {
        var result = await DialogService.OpenSideAsync<ProductCreate>("Nuevo Producto",
            null,
            new SideDialogOptions
            {
                Width = "600px",
                ShowClose = false,
                ShowMask = true,
                CloseDialogOnOverlayClick = true,
                Position = DialogPosition.Right
            });

        if (result)
        {
            _travel = TravelState.CurrentTravel;
        }
    }
}
