@page "/products/create"

@using EasyShop.Domain.Primitives
@using EasyShop.Features.Commons
@using EasyShop.Features.Products
@using EasyShop.Services

@inject CreateProductHandler Handler
@inject TravelStateService TravelState
@inject NotificationService NotificationService

<PageContainer>
    <RadzenRow>
        <RadzenColumn>
            <PageHeader Title="Nuevo producto" Icon="inventory_2" />
        </RadzenColumn>
    </RadzenRow>

    @if (_travel == null)
    {
        <EmptyState Icon="travel" Title="No hay viaje activo" Message="Selecciona o crea un viaje primero">
            <RadzenButton Icon="travel" ButtonStyle="ButtonStyle.Primary" Text="Ir a Viajes"
                          Click="@(() => NavigationManager.NavigateTo("/travels"))" />
        </EmptyState>
    }
    else
    {
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Vertical" Gap="1.5rem">

                <RadzenRow>
                    <RadzenColumn Size="12">
                        <RadzenFormField Text="Nombre" Style="width:100%;">
                            <RadzenTextBox @bind-Value="@_name" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Unidades" Style="width:100%;">
                            <RadzenNumeric @bind-Value="@_units" Min="0" Step="1" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Multiplicador" Style="width:100%;">
                            <RadzenNumeric @bind-Value="@_multiplicator" Min="0" Step="0.01" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn Size="12">
                        <RadzenFormField Text="@($"Costo total ({_travel!.MoneyToTravel.Currency})")" Style="width:100%;">
                            <RadzenNumeric @bind-Value="@_totalCostAmount" Min="0" Step="0.01" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="@($"Precio venta ({_travel!.MoneyToTravel.Currency})")" Style="width:100%;">
                            <RadzenNumeric Value="@_unitPrice" Min="0" Step="0.01" ReadOnly="true" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="@($"Precio venta ({_travel!.ChangeValue.Currency})")" Style="width:100%;">
                            <RadzenNumeric Value="@_unitChangePrice" Min="0" Step="0.01" ReadOnly="true" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow>
                    <RadzenColumn>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
                            <RadzenButton Text="Guardar" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Icon="save" Click="@HandleSubmit" />
                            <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Secondary" Icon="close" Click="@(() => NavigationManager.NavigateTo("/products"))" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>

            </RadzenStack>
        </RadzenCard>
    }
</PageContainer>

@code {
    private Travel? _travel;
    private string _name = string.Empty;
    private int _units = 12;
    private double _multiplicator;
    private decimal _totalCostAmount = 0m;
    private decimal _unitPrice => _units == 0 ? 0 : (_totalCostAmount / _units) * (decimal)_multiplicator;
    private decimal _unitChangePrice => _unitPrice * (decimal)(_travel?.ChangeValue.Amount ?? 1);

    protected override void OnInitialized()
    {
        _travel = TravelState.CurrentTravel;

        if (_travel != null)
        {
            _multiplicator = _travel.Multiplicator;
        }
    }

    private async Task HandleSubmit()
    {
        var currency = _travel!.MoneyToTravel.Currency;
        var changeCurrency = _travel.ChangeValue.Currency;

        var request = new CreateProductRequest(
            _travel.Id,
            _name,
            _units,
            _multiplicator,
            new MoneyRequest(_totalCostAmount, currency),
            new MoneyRequest(_unitPrice, currency),
            new MoneyRequest(_unitChangePrice, changeCurrency)
        );

        try
        {
            await Handler.HandleAsync(request);
            await TravelState.SetCurrentTravelAsync(_travel.Id);
            NotificationService.Notify(NotificationSeverity.Success, "Producto creado correctamente");
            NavigationManager.NavigateTo("/travels/products");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error al crear el producto", ex.Message);
        }
    }
}
