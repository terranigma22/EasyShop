@page "/cart"

@using EasyShop.Domain.Models
@using EasyShop.Services
@using EasyShop.Features.Products

@inject TravelStateService TravelState
@inject PurchaseCartHandler PurchaseCartHandler
@inject SetProductStatusHandler SetProductStatusHandler
@inject DeleteProductHandler DeleteProductHandler
@inject NotificationService NotificationService

<PageContainer>
    <RadzenRow>
            <RadzenColumn>
                <PageHeader Title="@($"Carrito: {_cartItems.Count}")"
                            Icon="shopping_cart_checkout" />
            </RadzenColumn>
            <RadzenColumn Style="align-self: center;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Base" Click="@Cancel" Variant="Variant.Text"/>
                </RadzenStack>
            </RadzenColumn>
    </RadzenRow>

    <RadzenStack Gap="1rem">
    @if (_cartItems.Count == 0)
    {
        <EmptyState Icon="shopping_cart" Title="Carrito vacío"
                    Message="Agrega productos al carrito desde la sección de productos" />
    }
    else
    {
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Icon="shopping_cart_checkout" ButtonStyle="ButtonStyle.Success"
                          Text="@($"Todo ({_cartItems.Count})")" Click="@ShowConfirmPurchaseAll" />
            @if (_selectedItems.Count > 0)
            {
                <RadzenButton Icon="shopping_cart_checkout" ButtonStyle="ButtonStyle.Primary"
                              Text="@($"{_selectedItems.Count}")" Click="@ShowConfirmPurchaseSelected" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                              Text="@($"{_selectedItems.Count}")" Click="@ShowConfirmDeleteSelected" />
            }
        </RadzenStack>

        @if (_selectedItems.Count > 0)
        {
            <RadzenCard Variant="Variant.Flat" Style="padding: 0.5rem 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Seleccionados: @_selectedItems.Count</RadzenText>
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="color: var(--rz-primary);">
                        <strong>Costo: @($"{_selectedTotal:F2} {_currency}")</strong>
                    </RadzenText>
                </div>
            </RadzenCard>
        }

        <EasyGridForCards>
            @foreach (var item in _cartItems)
            {
                <EasyColumForCard>
                    <EasyCartItem Data="item"
                                  IsSelected="@_selectedItems.Contains(item.Id)"
                                  IsSelectedChanged="@((value) => HandleSelectionChanged(item.Id, value))" />
                </EasyColumForCard>
            }
        </EasyGridForCards>

        <RadzenCard Variant="Variant.Flat" Style="padding: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <RadzenText TextStyle="TextStyle.H5"><strong>Total carrito</strong></RadzenText>
                <RadzenText TextStyle="TextStyle.H5" Style="color: var(--rz-success);"><strong>@($"{_total:F2} {_currency}")</strong></RadzenText>
            </div>
        </RadzenCard>
    }
</RadzenStack>
</PageContainer>

@code {
    Travel? _travel;
    List<Product> _cartItems = new();
    HashSet<Guid> _selectedItems = new();
    decimal _total;
    decimal _selectedTotal;
    string _currency = "USD";
    bool _changed;

    protected override void OnInitialized()
    {
        LoadCart();
    }

    void LoadCart()
    {
        _travel = TravelState.CurrentTravel;
        if (_travel != null)
        {
            _cartItems = _travel.Products.Where(p => p.Status == ProductStatus.InCart).ToList();
            _total = _cartItems.Sum(p => p.TotalCost.Amount);
            _currency = _travel.MoneyToTravel.Currency.ToString();
            _selectedItems.Clear();
        }
    }

    async Task ShowConfirmPurchaseAll()
    {
        var confirmed = await DialogService.Confirm(
            $"¿Comprar los {_cartItems.Count} productos en el carrito?",
            "Comprar todo",
            new ConfirmOptions { OkButtonText = "Sí", CancelButtonText = "No" });
        if (confirmed == true)
            await HandlePurchaseAll();
    }

    async Task ShowConfirmPurchaseSelected()
    {
        var confirmed = await DialogService.Confirm(
            $"¿Comprar los {_selectedItems.Count} productos seleccionados?",
            "Comprar seleccionados",
            new ConfirmOptions { OkButtonText = "Sí", CancelButtonText = "No" });
        if (confirmed == true)
            await HandlePurchaseSelected();
    }

    async Task ShowConfirmDeleteSelected()
    {
        var confirmed = await DialogService.Confirm(
            $"¿Eliminar los {_selectedItems.Count} productos seleccionados?",
            "Eliminar seleccionados",
            new ConfirmOptions { OkButtonText = "Sí", CancelButtonText = "No" });
        if (confirmed == true)
            await HandleDeleteSelected();
    }

    void HandleSelectionChanged(Guid productId, bool selected)
    {
        if (selected) _selectedItems.Add(productId);
        else _selectedItems.Remove(productId);
        _selectedTotal = _cartItems
            .Where(p => _selectedItems.Contains(p.Id))
            .Sum(p => p.TotalCost.Amount);
    }

    async Task HandlePurchaseSelected()
    {
        foreach (var id in _selectedItems.ToList())
        {
            await SetProductStatusHandler.HandleAsync(new SetProductStatusRequest(id, ProductStatus.Purchased));
        }
        await TravelState.SetCurrentTravelAsync(_travel!.Id);
        _travel = TravelState.CurrentTravel;
        LoadCart();
        _changed = true;
        NotificationService.Notify(NotificationSeverity.Success, "Productos comprados");
    }

    async Task HandleDeleteSelected()
    {
        foreach (var id in _selectedItems.ToList())
        {
            await DeleteProductHandler.HandleAsync(new DeleteProductRequest(id));
        }
        await TravelState.SetCurrentTravelAsync(_travel!.Id);
        _travel = TravelState.CurrentTravel;
        LoadCart();
        _changed = true;
        NotificationService.Notify(NotificationSeverity.Success, "Productos eliminados");
    }

    async Task HandlePurchaseAll()
    {
        await PurchaseCartHandler.HandleAsync(new PurchaseCartRequest(_travel!.Id));
        await TravelState.SetCurrentTravelAsync(_travel.Id);
        _changed = true;
        NavigationManager.NavigateTo("/products");
    }

    void Cancel() => NavigationManager.NavigateTo("/products");
}
