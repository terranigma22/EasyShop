@page "/incomes"

@using EasyShop.Domain.Models
@using EasyShop.Services
@using EasyShop.Features.Incomes

@inject TravelStateService TravelState
@inject DeleteIncomeHandler DeleteIncomeHandler
@inject NotificationService NotificationService

<PageContainer>
    <RadzenRow>
        <RadzenColumn>
            <PageHeader Title="@($"Entradas: {_travel?.Incomes.Count}")" Icon="account_balance" />
        </RadzenColumn>
        <RadzenColumn Style="align-self: center;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                              Click="@Create" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    @if (_travel == null)
    {
        <EmptyState Icon="travel" Title="No hay viaje activo" Message="Selecciona un viaje para ver sus ingresos">
            <RadzenButton Icon="travel" ButtonStyle="ButtonStyle.Primary" Text="Ir a Viajes"
                          Click="@(() => NavigationManager.NavigateTo("/travels"))" />
        </EmptyState>
    }
    else if (_travel.Incomes.Count == 0)
    {
        <EmptyState Icon="account_balance" Title="Sin entradas" Message="Este viaje no tiene entradas registradas">
            <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Text="Crear primera entrada"
                              Click="@Create" />
        </EmptyState>
    }
    else
    {
        <ListContainer>
            <AnimateFadeIn>
                <EasyGridForCards>
                    @foreach (var item in _travel.Incomes)
                    {
                        <EasyColumForCard>
                            <EasyIncomeCard Data="item" Delete="@HandleDelete" />
                        </EasyColumForCard>
                    }
                </EasyGridForCards>
            </AnimateFadeIn>
        </ListContainer>
    }
</PageContainer>

@code {
    Travel? _travel;

    protected override void OnInitialized()
    {
        _travel = TravelState.CurrentTravel;
    }

    private async Task HandleDelete(Guid id)
    {
        var confirmed = await DialogService.Confirm(
            "¿Estás seguro de eliminar esta entrada?",
            "Eliminar Entrada",
            new ConfirmOptions { OkButtonText = "Sí", CancelButtonText = "No" });

        if (confirmed == true)
        {
            await DeleteIncomeHandler.HandleAsync(new DeleteIncomeRequest(id));
            await TravelState.SetCurrentTravelAsync(_travel!.Id);
            _travel = TravelState.CurrentTravel;
            NotificationService.Notify(NotificationSeverity.Success, "Entrada eliminada correctamente");
        }
    }

    async Task Create()
    {
        var result = await DialogService.OpenSideAsync<IncomeCreate>("Nueva Entrada",
            null,
            new SideDialogOptions
            {
                Width = "600px",
                ShowClose = false,
                ShowMask = true,
                CloseDialogOnOverlayClick = true,
                Position = DialogPosition.Right
            });

        if (result)
        {
            _travel = TravelState.CurrentTravel;
        }
    }
}
