@page "/incomes"

@using EasyShop.Domain.Models
@using EasyShop.Services

@inject TravelStateService TravelState
@inject NotificationService NotificationService

<PageContainer>
    <RadzenRow>
        <RadzenColumn>
            <PageHeader Title="Entradas" Icon="account_balance" />
        </RadzenColumn>
        <RadzenColumn Style="align-self: center;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                              Click="@(() => NavigationManager.NavigateTo("/incomes/create"))" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    @if (_travel == null)
    {
        <EmptyState Icon="travel" Title="No hay viaje activo" Message="Selecciona un viaje para ver sus inentradasgresos">
            <RadzenButton Icon="travel" ButtonStyle="ButtonStyle.Primary" Text="Ir a Viajes"
                          Click="@(() => NavigationManager.NavigateTo("/travels"))" />
        </EmptyState>
    }
    else if (_travel.Incomes.Count == 0)
    {
        <EmptyState Icon="account_balance" Title="Sin entradas" Message="Este viaje no tiene entradas registrados" />
    }
    else
    {
        <AnimateFadeIn>
            <RadzenRow Gap="1rem">
                @foreach (var income in _travel.Incomes)
                {
                    <RadzenColumn Size="12" SizeSmall="6" SizeMedium="4">
                        <RadzenCard Variant="Variant.Flat" class="animate-card">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                         JustifyContent="JustifyContent.SpaceBetween">
                                <span style="font-weight: 500;">@income.Description</span>
                                <span style="font-weight: 600; color: var(--rz-success);">
                                    + @($"{income.Value.Amount:F2} {income.Value.Currency}")
                                </span>
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>
        </AnimateFadeIn>
    }
</PageContainer>

@code {
    Travel? _travel;

    protected override void OnInitialized()
    {
        _travel = TravelState.CurrentTravel;
    }
}
