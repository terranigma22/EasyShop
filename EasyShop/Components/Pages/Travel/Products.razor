@page "/travels/products"
@using EasyShop.Domain.Models
@using EasyShop.Services

@inject TravelStateService TravelState
@inject NotificationService NotificationService

<PageContainer>
    <RadzenRow>
        <RadzenColumn>
            <PageHeader Title="Productos" Icon="inventory_2" />
        </RadzenColumn>
        <RadzenColumn Style="align-self: center;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Text="Nuevo producto"
                              Click="@(() => NavigationManager.NavigateTo("/travels/products/create"))" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    @if (_travel == null)
    {
        <EmptyState Icon="travel" Title="No hay viaje activo" Message="Selecciona un viaje para ver sus productos">
            <RadzenButton Icon="travel" ButtonStyle="ButtonStyle.Primary" Text="Ir a Viajes"
                          Click="@(() => NavigationManager.NavigateTo("/travels"))" />
        </EmptyState>
    }
    else if (_travel.Products.Count == 0)
    {
        <EmptyState Icon="inventory_2" Title="Sin productos" Message="Este viaje no tiene productos registrados" />
    }
    else
    {
        <AnimateFadeIn>
            <RadzenRow Gap="1rem">
                @foreach (var product in _travel.Products)
                {
                    <RadzenColumn Size="12" SizeSmall="6" SizeMedium="4">
                        <RadzenCard Variant="Variant.Flat" class="animate-card">
                            <RadzenStack Gap="0.5rem">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenBadge Text="Producto" BadgeStyle="BadgeStyle.Info" />
                                    <span style="font-weight: 500;">
                                        @product.Units uds × @($"{product.GetUnitCost():F2} {product.TotalCost.Currency}")
                                    </span>
                                </RadzenStack>
                                <div style="display: flex; justify-content: space-between;">
                                    <span style="color: var(--rz-text-secondary); font-size: 0.875rem;">Costo total</span>
                                    <span style="font-weight: 500;">@($"{product.TotalCost.Amount:F2} {product.TotalCost.Currency}")</span>
                                </div>
                                <div style="display: flex; justify-content: space-between;">
                                    <span style="color: var(--rz-text-secondary); font-size: 0.875rem;">Precio venta</span>
                                    <span style="font-weight: 500;">@($"{product.UnitPrice.Amount:F2} {product.UnitPrice.Currency}")</span>
                                </div>
                                <div style="display: flex; justify-content: space-between;">
                                    <span style="color: var(--rz-text-secondary); font-size: 0.875rem;">Ganancia</span>
                                    <span style="font-weight: 600; color: var(--rz-success);">
                                        @($"{product.GetProfit():F2} {product.TotalCost.Currency}")
                                    </span>
                                </div>
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>
        </AnimateFadeIn>
    }
</PageContainer>

@code {
    Travel? _travel;

    protected override void OnInitialized()
    {
        _travel = TravelState.CurrentTravel;
    }
}
