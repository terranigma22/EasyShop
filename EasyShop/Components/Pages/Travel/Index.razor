@page "/travels"

@using EasyShop.Features.Travels

@inject GetTravelsHandler GetTravelsHandler
@inject DeleteTravelHandler DeleteTravelHandler
@inject TravelStateService TravelState
@inject NotificationService NotificationService

<PageContainer>
    <RadzenRow>
        <RadzenColumn>
            <PageHeader Title="@($"Viajes: {_items?.Count}")" Icon="travel" />
        </RadzenColumn>
        <RadzenColumn Style="align-self: center;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                              Click="@Create" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    @if (_loading)
    {
        <Loader />
    }
    else if (_items.Count == 0)
    {
        <EmptyState Icon="travel" Title="No hay viajes" Message="Crea tu primer viaje para comenzar">
            <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Text="Crear primer viaje"
                              Click="@Create" />
        </EmptyState>
    }
    else
    {
        <AnimateFadeIn>
            <EasyGridForCards>

                @foreach (var item in _items)
                {
                    <EasyColumForCard>
                        <EasyTravelCard Data="item" IsCurrent="item.Id == TravelState.CurrentTravel?.Id"
                                       Click="@HandleCardSelected" Delete="@HandleDelete" />
                    </EasyColumForCard>
                }
            </EasyGridForCards>
        </AnimateFadeIn>
    }
</PageContainer>

    @code {
    private List<Travel> _items = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTravels();
    }

    private async Task LoadTravels()
    {
        _loading = true;
        try
        {
            _items = await GetTravelsHandler.HandleAsync(new GetTravelsRequest());
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleCardSelected(Guid id)
    {
        await TravelState.SetCurrentTravelAsync(id);
    }

    private async Task HandleDelete(Guid id)
    {
        var confirmed = await DialogService.Confirm(
            "¿Estás seguro de eliminar este viaje? Se eliminarán también todos sus productos, gastos e ingresos asociados.",
            "Eliminar Viaje",
            new ConfirmOptions { OkButtonText = "Sí", CancelButtonText = "No" });

        if (confirmed == true)
        {
            await DeleteTravelHandler.HandleAsync(new DeleteTravelRequest(id));

            if (TravelState.CurrentTravel?.Id == id)
                TravelState.Clear();

            await LoadTravels();
        }
    }

    async Task Create()
    {
        var result = await DialogService.OpenSideAsync<TravelCreate>("Nuevo Viaje",
            null,
            new SideDialogOptions
            {
                Width = "600px",
                ShowClose = false,
                ShowMask = true,
                CloseDialogOnOverlayClick = true,
                Position = DialogPosition.Right
            });

        if (result is not null && result == true)
            await LoadTravels();

    }
}
