@inherits LayoutComponentBase

@using EasyShop.Components.Pages.Travel
@using EasyShop.Domain.Commons
@inject TravelStateService TravelState
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenComponents />
<RadzenTheme Theme="material-light" />

<RadzenLayout style="position: relative; grid-template-areas: 'rz-sidebar rz-header' 'rz-sidebar rz-body'">
   
    <RadzenHeader>

        <ChildContent>
            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0">
                <RadzenColumn Size="8">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)"/>
                        @if (TravelState.CurrentTravel != null)
                        {
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Base"
                                          Size="ButtonSize.Small" Variant="Variant.Text"
                                          Click="@HandleEdit"
                                          Text="@($"{TravelState.CurrentTravel.StartDate:dd/MM} → {TravelState.CurrentTravel.EndDate:dd/MM}")" />
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="4">

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.End" Gap="1rem">
                        @if (TravelState.CurrentTravel != null && _cartCount > 0)
                        {
                            <RadzenButton Text="@_cartCount.ToString()" Icon="shopping_cart_checkout" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" Click="@OpenCart" class="rz-border-radius-10" />
                        }
                        <RadzenAppearanceToggle LightTheme="material" DarkTheme="material-dark" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </ChildContent>

    </RadzenHeader>

    <RadzenSidebar Responsive="false" @bind-Expanded="@sidebarExpanded" style="position: absolute; z-index: 3; display: flex; flex-direction: column; height: 100%">
        <div>
            <RadzenStack AlignItems="AlignItems.End" class="rz-p-2">
                <RadzenButton Icon="west" Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary"
                              Click="@(() => sidebarExpanded = false)" />
            </RadzenStack>
            <RadzenPanelMenu>
                <RadzenPanelMenuItem Text="Panel" Icon="dashboard" Path="/" Click="@OnClick" />
                <RadzenPanelMenuItem Text="Viajes" Icon="travel" Path="/travels" Click="@OnClick" />
                @if (TravelState.CurrentTravel != null)
                {
                    <RadzenPanelMenuItem Text="Productos" Icon="inventory_2" Path="/products" Click="@OnClick" />
                    <RadzenPanelMenuItem Text="Deseados" Icon="favorite" Path="/wishlist" Click="@OnClick" />
                    <RadzenPanelMenuItem Text="Gastos" Icon="money_off" Path="/expenses" Click="@OnClick" />
                    <RadzenPanelMenuItem Text="Entradas" Icon="account_balance" Path="/incomes" Click="@OnClick" />
                }
            </RadzenPanelMenu>
        </div>
        <div style="margin-top: auto; padding: 8px">
            <RadzenButton Icon="download" ButtonStyle="ButtonStyle.Base"
                          Style="width: 100%;" Text="Exportar base de datos"
                          Click="@ExportDatabase" />
        </div>
    </RadzenSidebar>
                
    <RadzenBody>
        @Body
    </RadzenBody>
            
</RadzenLayout>

@if (sidebarExpanded)
{
    <div @onclick="@(() => sidebarExpanded = false)" class="rz-dialog-mask" style="position: absolute; z-index: 2"></div>
}

@code {
    bool sidebarExpanded = false;
    int _cartCount;

    protected override async Task OnInitializedAsync()
    {
        sidebarExpanded = false;
        await TravelState.LoadLastTravelAsync();
        UpdateCartCount();
        TravelState.OnTravelChanged += () => { UpdateCartCount(); StateHasChanged(); };
        StateHasChanged();
    }

    void UpdateCartCount()
    {
        _cartCount = TravelState.CurrentTravel?.Products.Count(p => p.Status == EasyShop.Domain.Models.ProductStatus.InCart) ?? 0;
    }

    void OpenCart()
    {
        NavigationManager.NavigateTo("/cart");
    }

    private void OnClick()
    {
        sidebarExpanded = false;
    }

    private async Task HandleEdit()
    {
        var travel = TravelState.CurrentTravel;
        if (travel is null) return;

        var result = await DialogService.OpenSideAsync<TravelEdit>("Editar Viaje",
            new Dictionary<string, object?> { { "TravelId", travel.Id } },
            new SideDialogOptions
            {
                Width = "600px",
                ShowClose = true,
                ShowMask = true,
                CloseDialogOnOverlayClick = true,
                Position = DialogPosition.Right
            });

        if (result is not null && result == true)
        {
            await TravelState.SetCurrentTravelAsync(travel.Id);
            StateHasChanged();
        }
    }

    private async Task ExportDatabase()
    {
        try
        {
            var path = await ConectionDb.ExportToDownloadsAsync();
            if (path is not null)
                NotificationService.Notify(NotificationSeverity.Success,
                    $"Base de datos exportada a: {path}");
            else
                NotificationService.Notify(NotificationSeverity.Success,
                    "Base de datos exportada correctamente");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error,
                "Error al exportar", ex.Message);
        }
    }
}
