@inherits LayoutComponentBase

@inject TravelStateService TravelState

<RadzenComponents />
<RadzenTheme Theme="material-light" />

<RadzenLayout style="position: relative; grid-template-areas: 'rz-sidebar rz-header' 'rz-sidebar rz-body'">
   
    <RadzenHeader>

        <ChildContent>
            <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0">
                <RadzenColumn Size="8">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)"
                                             Icon="space_dashboard" />
                        @if (TravelState.CurrentTravel != null)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                <RadzenBadge BadgeStyle="BadgeStyle.Base" Style="font-size: 0.75rem;">
                                    @TravelState.CurrentTravel.StartDate.ToString("dd/MM") → @TravelState.CurrentTravel.EndDate.ToString("dd/MM")
                                </RadzenBadge>
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="4">

                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.End" Gap="1rem">
                        @if (TravelState.CurrentTravel != null && _cartCount > 0)
                        {
                            <RadzenButton Text="@_cartCount.ToString()" Icon="shopping_cart_checkout" ButtonStyle="ButtonStyle.Base" Click="@OpenCart" class="rz-border-radius-10" />
                        }
                        <RadzenAppearanceToggle LightTheme="material" DarkTheme="material-dark" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </ChildContent>

    </RadzenHeader>

    <RadzenSidebar Responsive="false" @bind-Expanded="@sidebarExpanded" style="position: absolute; z-index: 3">
        <RadzenStack AlignItems="AlignItems.End" class="rz-p-2">
            <RadzenButton Icon="west" Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary"
                          Click="@(() => sidebarExpanded = false)" />
        </RadzenStack>
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Panel" Icon="dashboard" Path="/" Click="@OnClick" />
            <RadzenPanelMenuItem Text="Viajes" Icon="travel" Path="/travels" Click="@OnClick" />
            @if (TravelState.CurrentTravel != null)
            {
                <RadzenPanelMenuItem Text="Productos" Icon="inventory_2" Path="/products" Click="@OnClick" />
                <RadzenPanelMenuItem Text="Deseados" Icon="favorite" Path="/wishlist" Click="@OnClick" />
                <RadzenPanelMenuItem Text="Gastos" Icon="money_off" Path="/expenses" Click="@OnClick" />
                <RadzenPanelMenuItem Text="Entradas" Icon="account_balance" Path="/incomes" Click="@OnClick" />
            }
        </RadzenPanelMenu>
    </RadzenSidebar>
                
    <RadzenBody>
        @Body
    </RadzenBody>
            
</RadzenLayout>

@if (sidebarExpanded)
{
    <div @onclick="@(() => sidebarExpanded = false)" class="rz-dialog-mask" style="position: absolute; z-index: 2"></div>
}

@code {
    bool sidebarExpanded = false;
    int _cartCount;

    protected override async Task OnInitializedAsync()
    {
        sidebarExpanded = false;
        await TravelState.LoadLastTravelAsync();
        UpdateCartCount();
        TravelState.OnTravelChanged += () => { UpdateCartCount(); StateHasChanged(); };
        StateHasChanged();
    }

    void UpdateCartCount()
    {
        _cartCount = TravelState.CurrentTravel?.Products.Count(p => p.Status == EasyShop.Domain.Models.ProductStatus.InCart) ?? 0;
    }

    void OpenCart()
    {
        NavigationManager.NavigateTo("/cart");
    }

    private void OnClick()
    {
        sidebarExpanded = false;
    }
}
